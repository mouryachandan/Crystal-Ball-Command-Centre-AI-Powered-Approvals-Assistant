# ==============================================================================
# Crystal Ball Command Centre - Backend Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# LLM Provider Configuration ('mock' | 'openai' | 'anthropic')
# Setting LLM_PROVIDER=mock enables instant local AI responses! (Change to 'openai' for live GPT-4o)
LLM_PROVIDER=mock

# OpenAI Configuration (Optional if LLM_PROVIDER=mock)
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o

# Anthropic Claude Configuration (Optional if LLM_PROVIDER=mock)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Resilience & Timeouts (JD requires strictly 8s timeout with graceful degradation)
LLM_TIMEOUT_MS=8000

# Rate Limiting (Session/IP throttling)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

