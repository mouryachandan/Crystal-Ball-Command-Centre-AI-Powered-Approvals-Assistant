  "version": "1.0.0",
  "description": "Production-grade backend for Crystal Ball Command Centre - Approvals AI Assistant",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
