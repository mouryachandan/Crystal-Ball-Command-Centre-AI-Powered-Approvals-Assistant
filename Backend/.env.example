# ==============================================================================
# Crystal Ball Command Centre - Backend Environment Variables (Example)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# LLM Provider Configuration ('mock' | 'openai' | 'anthropic')
# Default is 'mock' for instant zero-dependency local runs and testing
LLM_PROVIDER=mock

# OpenAI API Key (Required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic API Key (Required only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Resilience & Timeouts (8000ms = 8 seconds as per requirement)
LLM_TIMEOUT_MS=8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

